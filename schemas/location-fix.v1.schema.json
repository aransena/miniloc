{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miniloc.local/schemas/location-fix.v1.schema.json",
  "title": "miniloc location fix",
  "type": "object",
  "required": [
    "fix_sequence",
    "phone_wall_time_ms",
    "cache_received_wall_time_ms",
    "cache_received_elapsed_realtime_ns",
    "elapsed_realtime_ns",
    "age_ms",
    "delivery_latency_ms",
    "source_batch_size",
    "source_batch_index",
    "lat",
    "lon",
    "mock"
  ],
  "properties": {
    "fix_sequence": { "type": "integer", "minimum": 1 },
    "phone_wall_time_ms": { "type": "integer", "minimum": 0 },
    "cache_received_wall_time_ms": { "type": "integer", "minimum": 0 },
    "cache_received_elapsed_realtime_ns": { "type": "integer", "minimum": 0 },
    "elapsed_realtime_ns": { "type": "integer", "minimum": 0 },
    "age_ms": { "type": "integer", "minimum": 0 },
    "delivery_latency_ms": { "type": "integer", "minimum": 0 },
    "source_batch_size": { "type": "integer", "minimum": 1 },
    "source_batch_index": { "type": "integer", "minimum": 0 },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon": { "type": "number", "minimum": -180, "maximum": 180 },
    "horizontal_accuracy_m": { "type": ["number", "null"], "minimum": 0 },
    "altitude_m": { "type": ["number", "null"] },
    "vertical_accuracy_m": { "type": ["number", "null"], "minimum": 0 },
    "speed_mps": { "type": ["number", "null"], "minimum": 0 },
    "speed_accuracy_mps": { "type": ["number", "null"], "minimum": 0 },
    "bearing_deg": { "type": ["number", "null"], "minimum": 0, "maximum": 360 },
    "bearing_accuracy_deg": { "type": ["number", "null"], "minimum": 0 },
    "provider": { "type": "string" },
    "mock": { "type": "boolean" },
    "battery_pct": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }
  },
  "additionalProperties": true
}
