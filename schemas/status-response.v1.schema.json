{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miniloc.local/schemas/status-response.v1.schema.json",
  "title": "miniloc /status response",
  "type": "object",
  "required": [
    "type",
    "ok",
    "app",
    "version",
    "instance_id",
    "access_mode",
    "paired_host_id",
    "auth_required",
    "read_auth_required",
    "port",
    "discovery_service_type",
    "discovery_service_name",
    "foreground_service_active",
    "http_server_active",
    "location_permission",
    "background_location_permission",
    "notification_permission",
    "location_update_error",
    "availability_wake_lock_active",
    "availability_wifi_lock_active",
    "availability_multicast_lock_active",
    "availability_lock_error",
    "network_publish_error",
    "network_last_refresh_age_ms",
    "battery_optimization_ignored",
    "power_save_mode_active",
    "last_fix_sequence",
    "last_fix_age_ms",
    "last_fix_accuracy_m",
    "recent_fix_count",
    "battery_pct"
  ],
  "properties": {
    "type": { "const": "status" },
    "ok": { "const": true },
    "app": { "const": "miniloc" },
    "version": { "type": "string" },
    "instance_id": { "type": "string" },
    "access_mode": { "enum": ["paired", "open_lan"] },
    "paired_host_id": { "type": ["string", "null"] },
    "auth_required": { "type": "boolean" },
    "read_auth_required": { "type": "boolean" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "discovery_service_type": { "const": "_miniloc._tcp." },
    "discovery_service_name": { "type": "string" },
    "foreground_service_active": { "type": "boolean" },
    "http_server_active": { "type": "boolean" },
    "location_permission": { "enum": ["granted", "denied"] },
    "background_location_permission": { "enum": ["granted", "denied", "not_required"] },
    "notification_permission": { "enum": ["granted", "denied", "not_required"] },
    "location_update_error": { "type": ["string", "null"] },
    "availability_wake_lock_active": { "type": "boolean" },
    "availability_wifi_lock_active": { "type": "boolean" },
    "availability_multicast_lock_active": { "type": "boolean" },
    "availability_lock_error": { "type": ["string", "null"] },
    "network_publish_error": { "type": ["string", "null"] },
    "network_last_refresh_age_ms": { "type": ["integer", "null"], "minimum": 0 },
    "battery_optimization_ignored": { "type": ["boolean", "null"] },
    "power_save_mode_active": { "type": ["boolean", "null"] },
    "last_fix_sequence": { "type": ["integer", "null"], "minimum": 1 },
    "last_fix_age_ms": { "type": ["integer", "null"], "minimum": 0 },
    "last_fix_accuracy_m": { "type": ["number", "null"], "minimum": 0 },
    "recent_fix_count": { "type": "integer", "minimum": 0, "maximum": 10 },
    "battery_pct": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 }
  },
  "additionalProperties": true
}
