{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miniloc.local/schemas/pairing-payload.v1.schema.json",
  "title": "miniloc QR pairing payload",
  "type": "object",
  "required": [
    "type",
    "version",
    "host_id",
    "host_name",
    "pairing_token",
    "issued_at",
    "expires_in_s",
    "miniloc_port"
  ],
  "properties": {
    "type": { "const": "miniloc_pair" },
    "version": { "const": 1 },
    "host_id": { "type": "string", "minLength": 1 },
    "host_name": { "type": "string", "minLength": 1 },
    "pairing_token": {
      "type": "string",
      "minLength": 1,
      "description": "Host tools generate a 256-bit base64url token by default; custom tokens must be non-empty."
    },
    "issued_at": {
      "type": "string",
      "description": "ISO-8601 UTC timestamp with trailing Z."
    },
    "expires_in_s": { "type": "integer", "minimum": 1 },
    "miniloc_port": { "type": "integer", "minimum": 1, "maximum": 65535 }
  },
  "additionalProperties": true
}
