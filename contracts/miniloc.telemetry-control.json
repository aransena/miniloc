{
  "schema": "universal.edge.telemetry_control.v1",
  "id": "miniloc.telemetry_control.v1",
  "kind": "edge_telemetry_control",
  "target": {
    "type": "single_android_phone",
    "service": "LocationForegroundService",
    "host_model": "one paired host at a time"
  },
  "telemetry": {
    "streams": ["miniloc.location-stream.json"],
    "message_schemas": ["../schemas/location-fix.v1.schema.json", "../schemas/loc-ping-response.v1.schema.json"],
    "sampling": {
      "requested_interval_ms": 200,
      "min_update_interval_ms": 200,
      "max_update_delay_ms": 250
    },
    "buffering": {
      "latest_fix": "in_memory",
      "recent_fixes": 10,
      "persistence": "none"
    }
  },
  "commands": [
    {
      "name": "pair",
      "initiator": "phone_user",
      "acknowledgement": "confirmation screen and active UI state",
      "timeout": "pairing payload expires at issued_at + expires_in_s"
    },
    {
      "name": "start_sharing",
      "initiator": "phone_user",
      "acknowledgement": "foreground notification and /status foreground_service_active=true"
    },
    {
      "name": "stop_sharing",
      "initiator": "phone_user",
      "acknowledgement": "foreground service and HTTP server stop"
    },
    {
      "name": "forget_pairing",
      "initiator": "phone_user_or_authenticated_host",
      "acknowledgement": "pairing and cached fixes are cleared"
    }
  ],
  "permissions": "miniloc.permissions.json",
  "transport": {
    "type": "local_network_http",
    "api_surface": "miniloc.api-surface.json"
  },
  "offline": {
    "store_and_forward": false,
    "retry": "host-side polling and rediscovery only",
    "loss": "location fixes are not persisted; only the latest and last 10 in-memory fixes are exposed",
    "recovery": "host rediscovers phone on the same subnet and resumes polling"
  },
  "safety": {
    "silent_remote_start": false,
    "foreground_notification_required": true,
    "pairing_expiry_enforced": true,
    "cloud_or_cross_network_access": false,
    "user_controls": ["Stop sharing", "Forget pairing"]
  }
}
